# ============================================================
# Copy this file to ".env" (same folder as manage.py) and fill
# in your own values. Never commit the real ".env" file.
# ============================================================

# Google Gemini API key — see GUIDE.md for step-by-step instructions
# on how to generate this from Google AI Studio.
GOOGLE_API_KEY=your_api_key_here

# Which Gemini model to use for chat/summarization.
# gemini-2.5-flash is the recommended default: fast, cheap, generous
# free-tier quota. See GUIDE.md "Model choice" section for alternatives.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Embedding model used to build the searchable knowledge base of the
# uploaded document (used for retrieval-augmented Q&A).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Django secret key. Generate your own for anything beyond local use:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-this-key-for-any-real-deployment

# Set to False in production
DJANGO_DEBUG=True
